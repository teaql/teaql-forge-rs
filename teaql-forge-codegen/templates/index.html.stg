                        <td align="center"><a href="rust-assist-i18n" class="assist-btn rust-btn" title="Rust i18n assist">I18n</a></td>
                        <td align="center"><a href="golang-assist-i18n" class="assist-btn go-btn" title="Go i18n assist">I18n</a></td>
                        <td align="center"><a href="swift-assist-i18n" class="assist-btn swift-btn" title="Swift i18n assist">I18n</a></td>
                        <td align="center"><a href="python-assist-i18n" class="assist-btn py-btn" title="Python i18n assist">I18n</a></td>
                        <td align="center"><a href="dotnet-assist-i18n" class="assist-btn cs-btn" title=".NET i18n assist">I18n</a></td>
                        <td align="center"><a href="typescript-assist-i18n" class="assist-btn ts-btn" title="TypeScript i18n assist">I18n</a></td>
                    </tr>
                </tbody>
            </table>
            </div>
        </section>
    </div>

    <!-- Preview Modal -->
    <div class="modal-overlay" id="preview-modal" onclick="closeModal(event)">
        <div class="modal-container" onclick="event.stopPropagation()">
            <div class="modal-header">
                <div class="modal-title" id="modal-title">AI Prompt Preview</div>
                <button class="modal-close" onclick="closeModal()">&times;</button>
            </div>
            <div class="modal-body">
                <pre id="modal-content">Loading...</pre>
            </div>
        </div>
    </div>

    <script>
        // Dynamically set the endpoint to the actual host url (including subpaths like /latest/)
        const endpointCode = document.getElementById('endpoint-code');
        let currentUrl = window.location.href;
        if (!currentUrl.endsWith('/')) {
            currentUrl += '/';
        }
        const exportCmd = 'export TEAQL_ENDPOINT_PREFIX=' + currentUrl;
        endpointCode.textContent = exportCmd;

        function copyEndpoint() {
            navigator.clipboard.writeText(exportCmd).then(() => {
                const btn = document.querySelector('.copy-btn');
                const originalText = btn.textContent;
                btn.textContent = 'Copied! ✓';
                btn.style.background = '#10b981'; // green
                setTimeout(() => {
                    btn.textContent = originalText;
                    btn.style.background = '#3b82f6';
                }, 2000);
            });
        }

        // Modal Logic
        const modal = document.getElementById('preview-modal');
        const modalTitle = document.getElementById('modal-title');
        const modalContent = document.getElementById('modal-content');

        function openModal(title, url) {
            modalTitle.textContent = title;
            modalContent.textContent = 'Loading...';
            modal.classList.add('active');
            document.body.style.overflow = 'hidden';

            fetch(url)
                .then(res => res.text())
                .then(text => {
                    modalContent.textContent = text;
                })
                .catch(err => {
                    modalContent.textContent = 'Failed to load preview: ' + err;
                });
        }

        function closeModal(e) {
            if (e && e.target !== modal && e.target.className !== 'modal-close') return;
            modal.classList.remove('active');
            document.body.style.overflow = '';
        }

        // Intercept assist button clicks
        document.querySelectorAll('.assist-btn').forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                let path = btn.getAttribute('href');
                if (path.startsWith('/')) {
                    path = path.substring(1);
                }
                const url = currentUrl + path;
                const title = btn.getAttribute('title') || 'Preview';
                openModal(title, url);
            });
        });
    </script>
</body>
</html>
