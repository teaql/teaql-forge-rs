use teaql_core::Expr;

use crate::*;

pub struct PurposedQuery\<T\> {
    pub inner: T,
    pub purpose: String,
}

impl\<T\> PurposedQuery\<T\> {
    pub fn new(inner: T, purpose: impl Into\<String\>) -> Self {
        let purpose = purpose.into();
        assert!(!purpose.trim().is_empty(), "query purpose must not be empty");
        Self { inner, purpose }
    }
}

pub struct Q;

impl Q {
<domain.objectDescriptors:qMethod();separator="\n\n">
}
>>

requestModule(objectDescriptor) ::= <<
mod <objectDescriptor.rustModuleName>;
pub use <objectDescriptor.rustModuleName>::*;
>>

qMethod(objectDescriptor) ::= <<
    pub fn <objectDescriptor.rustPluralName>() -> <objectDescriptor.rustStructName>Request {
        <objectDescriptor.rustStructName>Request::new()
            .select_self()
            .and_filter(Expr::gt("version", 0_i64))
    }

    pub fn <objectDescriptor.rustPluralName>_minimal() -> <objectDescriptor.rustStructName>Request {
        <objectDescriptor.rustStructName>Request::new()
            .and_filter(Expr::gt("version", 0_i64))
    }

    pub fn <objectDescriptor.rustPluralName>_with_children() -> <objectDescriptor.rustStructName>Request {
        <objectDescriptor.rustStructName>Request::new()
            .unlimited()
            .select_self_fields()
            .enhance_children_if_needed()
    }

<objectDescriptor.businessIdFields:rustBusinessIdLookup(objectDescriptor);separator="\n">
>>

rustBusinessIdLookup(field, objectDescriptor) ::= <<
    pub fn <objectDescriptor.rustModuleName>_by_<field.rustStorageMemberName>(value: crate::<field.rustBusinessIdTypeName>) -> <objectDescriptor.rustStructName>Request {
        Self::<objectDescriptor.rustPluralName>()
            .<field.rustAttributePredicatePrefixExpr>_is(value)
            .limit(2)
    }
>>

