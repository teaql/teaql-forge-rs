businessIdValueType(field) ::= <<
#[derive(Clone, Debug, PartialEq, Eq, PartialOrd, Ord, Hash)]
pub struct <field.rustBusinessIdTypeName>(String);

impl <field.rustBusinessIdTypeName> {
    pub fn new(value: impl Into\<String\>) -> Result\<Self, &'static str\> {
        let value = value.into().trim().to_owned();
        if value.is_empty() {
            return Err("<field.canonicalPropertyName> must not be blank");
        }
        Ok(Self(value))
    }

    pub(crate) fn from_canonical(value: impl Into\<String\>) -> Self {
        Self(value.into())
    }

    pub fn as_str(&self) -> &str { &self.0 }

    pub fn definition() -> teaql_core::business_id::BusinessIdDefinition {
        teaql_core::business_id::BusinessIdDefinition {
            field_name: "<field.canonicalPropertyName>".to_owned(),
            profile: "<field.businessIdProfile>".to_owned(),
            prefix: "<field.businessIdPrefix>".to_owned(),
            namespace: "<field.businessIdNamespace>".to_owned(),
            split_by_date: <field.businessIdSplitByDate>,
            preserve_digits: <field.businessIdDigits>,
            separator: "<field.businessIdSeparator>".to_owned(),
        }
    }
}

impl From\<<field.rustBusinessIdTypeName>\> for teaql_core::Value {
    fn from(value: <field.rustBusinessIdTypeName>) -> Self {
        teaql_core::Value::Text(value.0)
    }
}

impl From\<&<field.rustBusinessIdTypeName>\> for teaql_core::Value {
    fn from(value: &<field.rustBusinessIdTypeName>) -> Self {
        teaql_core::Value::Text(value.0.clone())
    }
}
>>

