        (!self.0.<field.rustStorageMemberName>.is_empty()).then_some(self.0.<field.rustStorageMemberName>.as_str())
    }

    fn is_new_aggregate(&self) -> bool {
        self.1
    }

    fn assign_business_id(&mut self, value: teaql_core::business_id::BusinessIdValue) {
        self.0.update_<field.rustStorageMemberName>(<field.rustBusinessIdTypeName>::from_canonical(value.0));
    }
}
