oneToOneReverseRelationMethods(relation) ::= <<
    /// Returns the relation view installed by the query that loaded this entity.
    /// This method never performs an implicit database query.
    pub fn <relation.rustMemberName>(&self) -> teaql_runtime::RelationHandle\<'_, crate::<relation.child.rustStructName>\> {
