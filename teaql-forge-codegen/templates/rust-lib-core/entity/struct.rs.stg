            \<Self as teaql_core::TeaqlEntity\>::ENTITY_NAME,
            self.id(),
            "<relation.rustMemberName>",
        )
    }

    pub fn eval_<relation.rustMemberName>(&self) -> teaql_core::eval::EvalResult\<&crate::<relation.child.rustStructName>\> {
        let relation = self.<relation.rustMemberName>();
        match relation.state() {
            teaql_runtime::LoadedRelation::Loaded => teaql_core::eval::EvalResult::Value(relation.value().expect("loaded relation must have a value")),
            teaql_runtime::LoadedRelation::Empty => teaql_core::eval::EvalResult::Null,
            teaql_runtime::LoadedRelation::NotLoaded => teaql_core::eval::EvalResult::NotLoaded { failed_node: "<relation.rustMemberName>".to_string(), attempted_path: "<relation.rustMemberName>".to_string() },
        }
    }
>>

