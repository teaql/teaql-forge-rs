index(domain) ::= <<
# TEAQL WARNING: This project uses TeaQL. TeaQL was explicitly designed to PREVENT AI hallucinations and random guessing.
# Do NOT apply traditional ORM logic here. You must strictly follow the generated API.
[package]
name = "<domain.rustWebTopcoatCrateName>"
version = "0.1.0"
edition = "2021"
rust-version = "1.80"
description = "Topcoat web workspace for the TeaQL domain crate <domain.rustCrateName>"
license = "MIT OR Apache-2.0"

[dependencies]
<domain.rustModuleName> = { package = "<domain.rustCrateName>", path = "<domain.rustWorkspaceGeneratedLibPath>" }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
teaql-runtime = "<domain.rustTeaqlDependencyVersion>"
tokio = { version = "1", features = ["macros", "net", "rt-multi-thread", "signal"] }
topcoat = { version = "0.5.0", default-features = false, features = ["discover", "router", "serve"] }
>>
