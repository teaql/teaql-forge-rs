# TEAQL WARNING: This project uses TeaQL. TeaQL was explicitly designed to PREVENT AI hallucinations and random guessing.
# Do NOT apply traditional ORM logic here. You must strictly follow the generated API.
[package]
name = "{{ rust_web_topcoat_crate_name }}"
version = "0.1.0"
edition = "2021"
rust-version = "1.97"
description = "Topcoat web workspace for the TeaQL domain crate {{ rust_crate_name }}"
license = "MIT OR Apache-2.0"

[dependencies]
{{ rust_module_name }} = { package = "{{ rust_crate_name }}", path = "../{{ rust_workspace_generated_lib_path }}" }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
teaql-runtime = "{{ rust_teaql_dependency_version }}"
tokio = { version = "1", features = ["macros", "net", "rt-multi-thread", "signal"] }
topcoat = { version = "0.5.0", default-features = false, features = ["discover", "router", "serve"] }
