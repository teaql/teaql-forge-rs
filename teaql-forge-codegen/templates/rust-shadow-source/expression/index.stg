    pub fn get_<fieldDescriptor.rustStorageMemberName>(self) -> crate::ValueExpression\<'a, <fieldDescriptor.rustStorageType>\> {
        let next = self.result.and_then("<fieldDescriptor.rustStorageFieldName>", |entity| entity.eval_<fieldDescriptor.rustStorageMemberName>());
        crate::ValueExpression::new(next, self.root_desc.clone())
    }
>>

