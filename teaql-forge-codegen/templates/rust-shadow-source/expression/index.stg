        let next = self.result.and_then("<relation.rustMemberName>", |entity| entity.eval_<relation.rustMemberName>());
        crate::<relation.child.rustStructName>Expression::new(next, self.root_desc.clone())
    }
>>

oneToManyReverseRelationAccessor(relation) ::= <<
    pub fn get_<relation.rustMemberName>(self) -> crate::<relation.child.rustStructName>ListExpression\<'a\> {
        let next = self.result.and_then("<relation.rustMemberName>", |entity| entity.eval_<relation.rustMemberName>());
        crate::<relation.child.rustStructName>ListExpression::new(next, self.root_desc.clone())
    }
