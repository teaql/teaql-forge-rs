constantObjectExpressionAccessor(fieldDescriptor) ::= <<
<fieldDescriptor.candidateForConst:{candidate | <constantObjectExpressionMethod(fieldDescriptor, candidate)>};separator="\n\n">
>>

constantObjectExpressionMethod(fieldDescriptor, candidate) ::= <<
    pub fn <fieldDescriptor.rustMemberName>_is_<candidate.rustCandidateMethodValue>(self) -> crate::ValueExpression\<'a, bool\> {
        let next = self.result.and_then("<fieldDescriptor.rustStorageFieldName>", |entity| {
            if !entity.is_loaded("<fieldDescriptor.rustStorageFieldName>") {
                teaql_core::eval::EvalResult::NotLoaded { failed_node: "<fieldDescriptor.rustStorageFieldName>".to_string(), attempted_path: "<fieldDescriptor.rustStorageFieldName>".to_string() }
            } else {
                teaql_core::eval::EvalResult::Value(entity.<fieldDescriptor.rustMemberName>_is_<candidate.rustCandidateMethodValue>())
            }
        });
        crate::ValueExpression::new(next, self.root_desc.clone())
    }
>>
